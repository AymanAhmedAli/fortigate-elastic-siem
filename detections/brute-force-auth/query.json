{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "event.code": "4625" } },
        { "term": { "winlog.event_data.LogonType": "3" } },
        { "range": { "@timestamp": { "gte": "now-5m" } } }
      ]
    }
  },
  "aggs": {
    "by_source": {
      "terms": {
        "field": "source.ip",
        "size": 20
      },
      "aggs": {
        "by_target_user": {
          "terms": {
            "field": "winlog.event_data.TargetUserName",
            "size": 20
          },
          "aggs": {
            "failed_attempts": {
              "value_count": {
                "field": "event.code"
              }
            }
          }
        }
      }
    }
  }
}
